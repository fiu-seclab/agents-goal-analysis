{
  "version": "1",
  "site": "gitea",
  "objectives": [
    "discovery",
    "retrieval",
    "enumeration",
    "curation",
    "service",
    "identity",
    "transaction",
    "availability"
  ],
  "agents": [
    "browser-use",
    "skyvern",
    "human"
