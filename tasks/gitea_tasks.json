    "GT01": {
      "label": "Find a repository by description",
      "objective": "discovery",
      "ask": "Find the repository owned by studyadmin whose description mentions badge printing (code {{nonce}}). Report its repository name.",
      "start_path": "/",
      "setup": [
        {
          "alias": "r1",
          "op": "repo",
          "owner": "studyadmin",
          "name": "alpha-{{nonce}}",
          "description": "Inventory sync service {{nonce}}",
          "default_branch": "main"
        },
        {
          "alias": "r2",
          "op": "repo",
          "owner": "studyadmin",
          "name": "beta-{{nonce}}",
          "description": "Badge printing tool {{nonce}}",
          "default_branch": "main"
        },
        {
          "alias": "r3",
          "op": "repo",
          "owner": "studyadmin",
          "name": "gamma-{{nonce}}",
          "description": "Release notes generator {{nonce}}",
          "default_branch": "main"
        }
      ],
      "constraints": {
        "kind": "report",
        "key": "name",
        "expected": "{{r2.name}}"
      },
      "verification": {
        "type": "self_report"
      },
      "hint": "Use the Gitea web UI only. Do not use the API, git over SSH, or the browser console.",
      "report_fields": {
        "name": "repository name or null"
      }
    },
