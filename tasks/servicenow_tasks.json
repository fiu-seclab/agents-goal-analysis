{
  "version": "1",
  "site": "servicenow",
  "objectives": [
    "discovery",
    "retrieval",
    "enumeration",
    "curation",
    "transaction",
    "identity",
    "service"
  ],
  "agents": [
    "browser-use",
    "skyvern",
    "human"
  ],
  "tasks": {
    "SN01": {
      "label": "Find incident by description",
      "objective": "discovery",
      "ask": "Find the incident whose short description mentions a badge reader (code {{nonce}}). Report its incident number.",
      "start_path": "/incident_list.do",
      "setup": [
        {
          "alias": "inc1",
          "table": "incident",
          "fields": {
            "short_description": "Printer jam on floor 3 {{nonce}}"
          }
        },
        {
          "alias": "inc2",
          "table": "incident",
          "fields": {
            "short_description": "Badge reader offline at lobby {{nonce}}"
          }
        },
        {
          "alias": "inc3",
          "table": "incident",
          "fields": {
            "short_description": "Projector flicker in room 12 {{nonce}}"
          }
        }
      ],
      "constraints": {
        "kind": "report",
        "key": "number",
        "expected": "{{inc2.number}}"
      },
      "verification": {
        "type": "self_report"
      },
      "report_fields": {
        "number": "INC… or null"
      },
      "hint": "Use the Incident list and its search or filter. Do not use the REST API."
    },
    "SN02": {
      "label": "Find problem by description",
